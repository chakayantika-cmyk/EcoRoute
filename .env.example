# =============================================================================
# EcoRoute AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Database ----
DATABASE_URL="postgresql://ecoroute:ecoroute_dev@localhost:5432/ecoroute_ai?schema=public"

# ---- Backend Server ----
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---- Frontend ----
VITE_API_URL=http://localhost:3001/api/v1
VITE_MOCK_MODE=false

# ---- Authentication ----
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ---- Execution Mode & Free Model Policy ----
# AI_MOCK_MODE: When 'false' (default), requires real providers. Never silently generates canned answers.
AI_MOCK_MODE=false

# FREE_MODELS_ONLY: When 'true' (default), only zero-cost API models (Ollama, Gemini Free Tier, Groq Free Tier) are eligible.
# When 'false', paid models (OpenAI, Anthropic, etc.) can participate if credentials are configured.
FREE_MODELS_ONLY=true

# Provider health probe cache TTL in seconds (default: 60)
PROVIDER_HEALTH_CACHE_TTL_SECONDS=60

# Master encryption key used to encrypt provider API keys at rest in the database
PROVIDER_ENCRYPTION_KEY=ecoroute-production-encryption-secret-key-32chars

# ---- AI Provider API Keys (Server-side only — never exposed to frontend) ----
# Free-tier capable providers:
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Paid providers (require FREE_MODELS_ONLY=false to participate):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=

# ---- Provider Timeouts (ms) ----
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=3

