# =============================================================================
# EcoRoute AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Database ----
DATABASE_URL="postgresql://ecoroute:ecoroute_dev@localhost:5432/ecoroute_ai?schema=public"

# ---- Backend Server ----
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---- Frontend ----
VITE_API_URL=http://localhost:3001/api/v1
VITE_MOCK_MODE=false

# ---- Authentication ----
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ---- AI Provider API Keys (optional — mock mode if absent) ----
# These keys are stored ONLY on the server. Never expose to frontend.
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Provider Timeouts (ms) ----
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=3
